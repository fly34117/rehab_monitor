page { background: #f0f2f5; font-family: -apple-system, sans-serif; }

.scroll-wrap { height: 100vh; }

.container { padding: 0 24rpx; }

/* 时间切换 */
.time-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 8rpx;
  background: #fff;
  border-radius: 14rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #888;
  background: transparent;
}

.tab.active {
  background: #1a73e8;
  color: #fff;
  font-weight: 600;
}

/* 图表卡片 */
.chart-card {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx 16rpx 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.chart-canvas {
  width: 100%;
  height: 380rpx;
}

/* 未锁定提示 */
.unlock-msg {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}
.unlock-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.unlock-text { font-size: 28rpx; color: #999; }
