page { background: #f5f5f5; font-family: -apple-system, sans-serif; }

.container { padding: 12rpx; }

/* 模式切换 */
.mode-tabs {
  display: flex;
  gap: 0;
  margin-bottom: 16rpx;
  background: #e8e8e8;
  border-radius: 12rpx;
  overflow: hidden;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s;
}
.mode-tab.active {
  background: #1a73e8;
  color: #fff;
  font-weight: 600;
}

/* 时间段选择 */
.period-select {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.option {
  flex: 1;
  text-align: center;
  padding: 14rpx;
  background: #fff;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #666;
}
.option.active { background: #1a73e8; color: #fff; }

/* 专家模式选项 */
.expert-options { margin-bottom: 12rpx; }
.option-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
  padding-left: 6rpx;
}
.expert-hint {
  background: #f0f7ff;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  color: #5a8ec9;
  margin-top: 8rpx;
}

/* 按钮 */
.btn-generate {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #1a73e8;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.btn-expert {
  background: linear-gradient(135deg, #1a73e8, #6c3fc9);
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.expert-card {
  background: linear-gradient(135deg, #1a237e, #283593);
  color: #fff;
}
.card-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}
.card-icon { font-size: 32rpx; }
.card-title { font-size: 28rpx; font-weight: 700; color: #fff; }
.expert-meta { display: flex; gap: 12rpx; }
.meta-tag {
  font-size: 20rpx;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  color: rgba(255,255,255,0.9);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

/* 摘要 */
.summary-text {
  font-size: 26rpx;
  color: #1a73e8;
  line-height: 1.6;
}

/* 步态评估 */
.assessment-overall { margin-bottom: 8rpx; }
.overall-badge {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  color: #fff;
  font-weight: 600;
}
.overall-badge {
  background: #e74c3c;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  color: #fff;
  font-weight: 600;
}

.detail-text {
  font-size: 23rpx;
  color: #666;
  margin-bottom: 6rpx;
  display: block;
}
.finding-item {
  font-size: 23rpx;
  color: #555;
  line-height: 1.7;
  padding-left: 4rpx;
}

/* 文献对比表格 */
.lit-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
  padding: 10rpx 4rpx;
  font-size: 22rpx;
  align-items: center;
}
.lit-name { flex: 1.2; text-align: left; font-weight: 500; color: #555; }
.lit-val { flex: 0.8; text-align: center; color: #e74c3c; font-weight: 600; }
.lit-ref { flex: 1.4; text-align: center; color: #888; font-size: 20rpx; }
.lit-assess { flex: 0.8; text-align: center; color: #e74c3c; font-weight: 600; }

/* 跌倒风险 */
.risk-level {
  font-size: 28rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-bottom: 10rpx;
  color: #fff;
}
.risk-high { background: #e74c3c; }
.risk-medium { background: #f39c12; }
.risk-low { background: #27ae60; }
.risk-none { background: #95a5a6; }

.lit-evidence {
  font-size: 22rpx;
  color: #888;
  line-height: 1.5;
  margin-top: 8rpx;
  display: block;
  padding: 8rpx;
  background: #f9f9f9;
  border-radius: 6rpx;
}

/* 临床建议 */
.rec-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.rec-item:last-child { border-bottom: none; }
.rec-header { margin-bottom: 4rpx; }
.rec-prio {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 6rpx;
  display: inline-block;
}
.prio-high { background: #e74c3c; }
.prio-medium { background: #f39c12; }
.prio-low { background: #95a5a6; }

.rec-action {
  font-size: 24rpx;
  color: #333;
  line-height: 1.6;
}
.rec-basis {
  font-size: 21rpx;
  color: #aaa;
  display: block;
  margin-top: 4rpx;
}

/* 报告文本 */
.report-text {
  font-size: 24rpx;
  color: #444;
  line-height: 1.8;
  white-space: pre-wrap;
}

.btn-share {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: #27ae60;
  color: #fff;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.empty-hint {
  padding: 120rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.8;
  white-space: pre-wrap;
}

.unlock-msg { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; }
.unlock-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.unlock-text { font-size: 28rpx; color: #999; }
