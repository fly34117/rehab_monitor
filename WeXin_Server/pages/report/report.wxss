page { background: #f5f5f5; font-family: -apple-system, sans-serif; }

.container { padding: 12rpx; }

.period-select {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.option {
  flex: 1;
  text-align: center;
  padding: 14rpx;
  background: #fff;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.option.active { background: #1a73e8; color: #fff; }

.btn-generate {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #1a73e8;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.summary-text {
  font-size: 26rpx;
  color: #1a73e8;
  line-height: 1.6;
}

.report-text {
  font-size: 24rpx;
  color: #444;
  line-height: 1.8;
  white-space: pre-wrap;
}

.btn-share {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: #27ae60;
  color: #fff;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.empty-hint {
  padding: 120rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.8;
  white-space: pre-wrap;
}

.unlock-msg { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; }
.unlock-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.unlock-text { font-size: 28rpx; color: #999; }
