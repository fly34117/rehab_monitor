page { background: #f0f2f5; font-family: -apple-system, sans-serif; height: 100vh; }

.page { display: flex; flex-direction: column; height: 100vh; padding: 0 24rpx; }

.map-header {
  padding: 30rpx 0 20rpx;
}

.map-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.map-sub {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.map-container {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.map-canvas {
  width: 100%;
  height: 100%;
}

.pos-overlay {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  right: 20rpx;
  background: rgba(0,0,0,0.7);
  border-radius: 10rpx;
  padding: 16rpx 24rpx;
}

.pos-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}

.pos-value {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  display: block;
  margin-top: 4rpx;
}

.legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding: 24rpx 0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.current {
  background: #e74c3c;
  box-shadow: 0 0 8rpx rgba(231,76,60,0.5);
}

.legend-dot.past {
  background: #95a5a6;
}

.legend-line {
  width: 24rpx;
  height: 4rpx;
  background: #1a73e8;
  border-radius: 2rpx;
}

.legend-item text {
  font-size: 22rpx;
  color: #666;
}

.unlock-msg { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; }
.unlock-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.unlock-text { font-size: 28rpx; color: #999; }
