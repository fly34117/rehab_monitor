page { background: #000; height: 100vh; }

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100vh;
  position: relative;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

.camera-preview {
  width: 100%;
  height: 100vh;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

.btn-stack {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.btn-square {
  background: rgba(128, 128, 128, 0.5);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  line-height: 80rpx;
}

.btn-flip {
  width: 240rpx;
  height: 80rpx;
}

.btn-capture {
  width: 280rpx;
  height: 100rpx;
  line-height: 100rpx;
}

.btn-album {
  width: 240rpx;
  height: 80rpx;
}

.is-disabled {
  opacity: 0.65;
}
