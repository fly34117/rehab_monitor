<view class="container">
  <camera
    device-position="{{cameraPosition}}"
    flash="off"
    binderror="onCameraError"
    class="camera-preview"
  ></camera>

  <cover-view class="btn-stack">
    <cover-view class="btn-square btn-flip" bindtap="flipCamera">翻转摄像头</cover-view>
    <cover-view class="btn-square btn-capture {{loading ? 'is-disabled' : ''}}" bindtap="takePhoto">
      {{loading ? '识别中...' : '拍照锁定'}}
    </cover-view>
    <cover-view class="btn-square btn-album" bindtap="chooseFromAlbum">从相册选择</cover-view>
  </cover-view>
</view>
