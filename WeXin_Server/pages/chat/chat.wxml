<view wx:if="{{!locked}}" class="unlock-msg">
  <text class="unlock-icon">🔒</text>
  <text class="unlock-text">请先在首页锁定患者</text>
</view>

<view wx:if="{{locked}}" class="chat-page">
  <view class="chat-header">
    <view class="header-main">
      <text class="header-title">AI 助手</text>
      <text class="header-desc">康复问答与报告生成</text>
    </view>
    <view class="header-actions">
      <button class="btn-report" bindtap="generateReport" disabled="{{sending}}">生成报告</button>
      <button wx:if="{{messages.length > 0}}" class="btn-clear" bindtap="clearChat">清除</button>
    </view>
  </view>

  <scroll-view
    class="chat-body"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-into-view="{{scrollIntoView}}"
  >
    <view wx:if="{{loading}}" class="empty-hint">
      <text class="empty-icon">...</text>
      <text>正在加载对话</text>
    </view>

    <view wx:if="{{!loading && messages.length === 0}}" class="empty-hint">
      <text class="empty-icon">💬</text>
      <text>暂无对话记录</text>
      <text class="empty-sub">可以直接输入问题，也可以点击右上角生成康复分析报告</text>
    </view>

    <view wx:if="{{!loading && messages.length > 0}}" class="chat-list">
      <view
        wx:for="{{messages}}"
        wx:key="index"
        class="chat-item {{item.role === 'user' ? 'msg-user' : 'msg-assistant'}}"
      >
        <view class="avatar">
          <text>{{item.role === 'user' ? '我' : 'AI'}}</text>
        </view>
        <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-assistant'}} {{item.streaming ? 'bubble-streaming' : ''}}">
          <text class="role-label">{{item.role === 'user' ? '你' : '小安'}}</text>
          <text class="content" selectable="true">{{item.content}}</text>
          <text wx:if="{{item.streaming}}" class="typing-cursor">|</text>
        </view>
      </view>
    </view>
    <view id="chat-bottom" class="chat-bottom-anchor"></view>
  </scroll-view>

  <view class="input-bar">
    <view class="input-shell">
      <input
        class="chat-input"
        placeholder="输入消息..."
        placeholder-class="chat-placeholder"
        value="{{inputText}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="sendMessage"
        adjust-position="{{false}}"
      />
    </view>
    <button class="btn-send" bindtap="sendMessage" disabled="{{sending}}">发送</button>
  </view>
</view>
