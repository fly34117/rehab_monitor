page { background: #f5f5f5; font-family: -apple-system, sans-serif; }

.container { padding: 12rpx; }

/* 头部 */
.header {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}
.header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}
.header-desc {
  font-size: 22rpx;
  color: #999;
}

/* 空状态 */
.empty-hint {
  padding: 120rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.empty-icon { font-size: 80rpx; }
.empty-hint > text:nth-child(2) {
  font-size: 28rpx;
  color: #999;
}
.empty-sub {
  font-size: 22rpx;
  color: #bbb;
  line-height: 1.6;
  margin-top: 8rpx;
}

/* 对话列表 */
.chat-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.chat-item {
  display: flex;
  gap: 10rpx;
}

.msg-user { flex-direction: row-reverse; }

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #e8e8e8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
}

.bubble {
  max-width: 75%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  position: relative;
}

.bubble-user {
  background: #1a73e8;
  border-top-right-radius: 4rpx;
}

.bubble-assistant {
  background: #fff;
  border-top-left-radius: 4rpx;
  border: 1rpx solid #e8e8e8;
}

.bubble-user .content { color: #fff; }
.bubble-assistant .content { color: #333; }

.role-label {
  font-size: 20rpx;
  opacity: 0.6;
  display: block;
  margin-bottom: 4rpx;
}
.bubble-user .role-label { color: rgba(255,255,255,0.7); }
.bubble-assistant .role-label { color: #999; }

.content {
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 清除按钮 */
.footer-bar {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.btn-clear {
  width: 60%;
  height: 72rpx;
  line-height: 72rpx;
  background: #fff;
  color: #e74c3c;
  border: 1rpx solid #e74c3c;
  border-radius: 12rpx;
  font-size: 26rpx;
}

/* 未解锁 */
.unlock-msg {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}
.unlock-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.unlock-text { font-size: 28rpx; color: #999; }
