page {
  background: #f4f7fb;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  height: 100vh;
}

.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #f4f7fb;
}

.chat-header {
  background: #fff;
  padding: 24rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #e7edf5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #17233c;
  display: block;
  margin-bottom: 6rpx;
}
.header-desc {
  font-size: 24rpx;
  color: #7d8a9c;
}

.chat-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 18rpx;
  box-sizing: border-box;
}

.empty-hint {
  min-height: 55vh;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 14rpx;
  color: #7d8a9c;
}
.empty-icon {
  font-size: 72rpx;
  line-height: 1;
}
.empty-hint > text:nth-child(2) {
  font-size: 30rpx;
  color: #344054;
  font-weight: 600;
}
.empty-sub {
  width: 520rpx;
  max-width: 90%;
  font-size: 24rpx;
  color: #98a2b3;
  line-height: 1.6;
}

.chat-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-bottom: 16rpx;
}

.chat-item {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.msg-user { flex-direction: row-reverse; }

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e8eef7;
  color: #426083;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
}

.bubble {
  max-width: 78%;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  position: relative;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.bubble-user {
  background: #1f7ae0;
  border-top-right-radius: 6rpx;
}

.bubble-assistant {
  background: #fff;
  border-top-left-radius: 6rpx;
  border: 1rpx solid #e7edf5;
}

.bubble-user .content { color: #fff; }
.bubble-assistant .content { color: #243042; }

.role-label {
  font-size: 20rpx;
  display: block;
  margin-bottom: 6rpx;
}
.bubble-user .role-label { color: rgba(255,255,255,0.72); }
.bubble-assistant .role-label { color: #8b98aa; }

.content {
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.chat-bottom-anchor { height: 2rpx; }

.btn-clear {
  width: 112rpx;
  height: 56rpx;
  line-height: 56rpx;
  background: #fff5f5;
  color: #d92d20;
  border: 1rpx solid #ffd5d2;
  border-radius: 28rpx;
  font-size: 24rpx;
  padding: 0;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e7edf5;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.06);
  flex-shrink: 0;
  box-sizing: border-box;
}

.chat-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  background: #f3f6fa;
  border-radius: 38rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #17233c;
  box-sizing: border-box;
}

.btn-send {
  width: 124rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: #1f7ae0;
  color: #fff;
  border-radius: 38rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 0;
}

.btn-report {
  width: 116rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: #eef6ff;
  color: #1f7ae0;
  border: 1rpx solid #b7d7ff;
  border-radius: 38rpx;
  font-size: 26rpx;
  padding: 0;
  text-align: center;
  flex-shrink: 0;
}

.btn-send[disabled],
.btn-report[disabled] {
  opacity: 0.55;
}

button::after {
  border: 0;
}

.unlock-msg {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: #f4f7fb;
}
.unlock-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.unlock-text { font-size: 28rpx; color: #7d8a9c; }
